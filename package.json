{
  "name": "shopper",
  "version": "1.0.0",
  "private": true,
  "description": "Shopper monorepo — client, server, shared",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build:shared": "pnpm --filter @shopper/shared build",
    "dev": "pnpm build:shared && pnpm run --parallel --filter @shopper/shared --filter @shopper/server --filter @shopper/client dev",
    "dev:client": "pnpm --filter @shopper/client dev",
    "dev:server": "pnpm --filter @shopper/server dev",
    "dev:shared": "pnpm --filter @shopper/shared dev",
    "build": "pnpm build:shared && pnpm --filter @shopper/server build && pnpm --filter @shopper/client build",
    "typecheck": "pnpm --filter @shopper/shared typecheck && pnpm --filter @shopper/client type-check",
    "lint": "pnpm --filter @shopper/client lint && pnpm --filter @shopper/server lint",
    "test": "pnpm --filter @shopper/client test --run && pnpm --filter @shopper/server test",
    "setup": "bash ./setup.sh",
    "start": "bash ./start.sh"
  }
}
