# Shopper — server environment (copy to server/.env)
# ./setup.sh fills secrets and picks Postgres vs SQLite.

APP_ENV=local
APP_NAME=Shopper
APP_DEBUG=true
APP_LOG_LEVEL=info

# auto = Postgres when reachable, otherwise SQLite. Production always uses Postgres.
# Set postgresql or sqlite to force one engine.
DATABASE_PROVIDER=auto
# memory = lru-cache in-process (default, no Redis). redis / auto also work.
CACHE_DRIVER=memory

# Comma-separated browser origins (local Next may use 3000–3002).
# Local APP_ENV also allows any localhost/127.0.0.1 origin dynamically.
APP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002

HTTP_HOST=0.0.0.0
HTTP_PORT=3001
HTTP_VERSIONING_ENABLE=true
HTTP_VERSION=1

AUTH_ACCESS_TOKEN_SECRET=change-me-access-token-secret-min-32-chars
AUTH_ACCESS_TOKEN_EXP=15m
AUTH_REFRESH_TOKEN_SECRET=change-me-refresh-token-secret-min-32-chars
AUTH_REFRESH_TOKEN_EXP=7d
BCRYPT_SALT_ROUNDS=10
OTP_EXPIRATION_MINUTES=10
OTP_MAX_ATTEMPTS=3

# Local Postgres (used when DATABASE_PROVIDER=auto and Postgres is reachable)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shopper
# SQLite fallback written by setup.sh when Postgres is not running:
# DATABASE_URL=file:./dev.db

# Optional. Ignored when CACHE_DRIVER=memory (the default).
REDIS_URL=redis://localhost:6379
CACHE_MAX_ITEMS=10000

# Storage: local (default) or s3 (R2/S3-compatible when credentials are set)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:3001/v1/media/file
STORAGE_MAX_BYTES_PRODUCT=5000000
STORAGE_MAX_BYTES_PROOF=3000000
STORAGE_MAX_BYTES_LOGO=2000000
STORAGE_MIN_WIDTH=400
STORAGE_MIN_HEIGHT=400
STORAGE_MAX_EDGE=4096

# S3 / R2 (used when STORAGE_DRIVER=s3)
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://xxxx.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_BASE_URL=https://cdn.example.com
