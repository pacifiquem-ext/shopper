# OnlineShop.rw — server environment (copy to server/.env)
# Full ledger: ../ENV.md

# --- Application ---
APP_ENV=local
APP_NAME=OnlineShop.rw
APP_DEBUG=true
APP_LOG_LEVEL=info
# Comma-separated. Local Next client:
APP_CORS_ORIGINS=http://localhost:3000

# --- HTTP (match client NEXT_PUBLIC_API_URL port) ---
HTTP_HOST=0.0.0.0
HTTP_PORT=3001
HTTP_VERSIONING_ENABLE=true
HTTP_VERSION=1

# --- Database (host machine → Compose Postgres published on 5432) ---
DATABASE_URL=postgresql://postgres:master123@localhost:5432/postgres

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth (required — generate strong random strings for anything beyond local toys) ---
AUTH_ACCESS_TOKEN_SECRET=change-me-access-token-secret-min-32-chars
AUTH_ACCESS_TOKEN_EXP=15m
AUTH_REFRESH_TOKEN_SECRET=change-me-refresh-token-secret-min-32-chars
AUTH_REFRESH_TOKEN_EXP=7d
BCRYPT_SALT_ROUNDS=10
OTP_EXPIRATION_MINUTES=10
OTP_MAX_ATTEMPTS=3

# --- Onboarding ---
# Local APP_ENV already auto-approves stores. Set true explicitly on non-local if desired.
# STORE_AUTO_APPROVE=true

# --- Observability ---
# SENTRY_DSN=

# --- Seed (optional, non-production) ---
# SEED_DEV_MERCHANT_PHONE=+250788000000
# SEED_DEV_MERCHANT_PASSWORD=ChangeMe123!
