// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STORE_OWNER
  PLATFORM_ADMIN
  CUSTOMER
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum OtpType {
  VERIFY_PHONE
  RESET_PASSWORD
}

enum StoreStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  DELETED
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum InventoryEventType {
  CREATED
  RESTOCKED
  SOLD
  ADJUSTED
  RETURNED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  MOBILE_MONEY
  BANK_TRANSFER
  CARD
}

enum FulfillmentStatus {
  UNFULFILLED
  PACKED
  SHIPPED
  FULFILLED
  CANCELLED
}

enum OrderEventType {
  CREATED
  PAID
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum MessageSender {
  ADMIN
  CUSTOMER
}

model User {
  id           String     @id @default(uuid())
  storeId      String?
  fullName     String
  phoneNumber  String     @unique
  email        String?
  passwordHash String
  role         UserRole   @default(CUSTOMER)
  status       UserStatus @default(PENDING_VERIFICATION)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  refreshTokens RefreshToken[]
  otpCodes      OtpCode[]
  stores        Store[]
  storeDraft    StoreDraft?

  @@index([phoneNumber])
  @@map("users")
}

model OtpCode {
  id          String   @id @default(uuid())
  phoneNumber String
  code        String
  type        OtpType
  attempts    Int      @default(0)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user User? @relation(fields: [phoneNumber], references: [phoneNumber], onDelete: Cascade)

  @@index([phoneNumber, type])
  @@map("otp_codes")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model IndustrySector {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories BusinessCategory[]
  storeKycs  StoreKyc[]

  @@map("industry_sectors")
}

model BusinessCategory {
  id               String   @id @default(uuid())
  industrySectorId String
  code             String   @unique
  name             String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  industrySector IndustrySector @relation(fields: [industrySectorId], references: [id], onDelete: Cascade)
  storeKycs      StoreKyc[]

  @@index([industrySectorId])
  @@map("business_categories")
}

model Store {
  id        String      @id @default(uuid())
  userId    String
  subdomain String      @unique
  status    StoreStatus @default(SUBMITTED)

  registeredName String
  displayName    String
  description    String?
  currency       String  @default("RWF")

  logoUrl     String?
  brandColors Json? // {"primary": "#xxxxxx", "secondary": "#xxxxxx", "template": "VIBRANT_MARKET"|"ISHUSHO_CRAFTS"}
  
  aboutUs      String?
  contactEmail   String?
  contactPhone   String?
  contactAddress String?

  returnPolicy         String?
  privacyPolicy        String?
  termsAndConditions   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rejectionReason String?

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  kyc      StoreKyc?
  delivery DeliveryZone[]
  products Product[]
  orders   Order[]
  dailyMetricsSnapshots     DailyMetricsSnapshot[]
  productPerformanceSnapshots ProductPerformanceSnapshot[]

  @@index([userId])
  @@index([subdomain])
  @@index([status])
  @@map("stores")
}

model DeliveryZone {
  id         String   @id @default(uuid())
  storeId    String
  name       String
  feeRwf     Int
  etaMinutes Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  store             Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderFulfillments OrderFulfillment[]

  @@index([storeId])
  @@map("delivery_zones")
}

model StoreKyc {
  id      String @id @default(uuid())
  storeId String @unique

  industrySectorId   String
  businessCategoryId String
  country            String

  ownerFullName    String
  ownerNationality String
  ownerEmail       String
  ownerPhoneNumber String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store            Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  industrySector   IndustrySector   @relation(fields: [industrySectorId], references: [id])
  businessCategory BusinessCategory @relation(fields: [businessCategoryId], references: [id])
  businessAddress  Address?         @relation("BusinessAddress")

  @@map("store_kycs")
}

model Address {
  id              String  @id @default(uuid())
  province        String
  district        String
  sector          String
  physicalAddress String
  googleMapsUrl   String?

  businessKycId  String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessKyc  StoreKyc? @relation("BusinessAddress", fields: [businessKycId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model StoreDraft {
  id                   String   @id @default(uuid())
  userId               String   @unique
  draftData            Json
  currentStep          Int      @default(1)
  completionPercentage Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("store_drafts")
}

model Product {
  id          String        @id @default(uuid())
  storeId     String
  name        String
  description String?
  vendor      String
  category    String
  status      ProductStatus @default(DRAFT)
  tags        String[]
  images      String[]
  primaryImage String?
  
  deliveryEnabled  Boolean  @default(true)
  deliveryLocation String?
  deliveryPrice    Decimal?
  
  createdBy String
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  store    Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variants ProductVariant[]
  
  @@index([storeId, status])
  @@index([storeId, category])
  @@index([storeId, vendor])
  @@map("products")
}

model ProductVariant {
  id        String @id @default(uuid())
  productId String
  
  sku       String @unique
  title     String
  
  colorName String?
  colorHex  String?
  size      String?
  model     String?
  
  price     Decimal
  compareAt Decimal?
  cost      Decimal?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  product              Product                      @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory            InventoryRecord?
  orderLineItems       OrderLineItem[]
  performanceSnapshots ProductPerformanceSnapshot[]
  
  @@index([productId])
  @@index([sku])
  @@map("product_variants")
}

model InventoryRecord {
  id               String @id @default(uuid())
  productVariantId String @unique
  
  onHand       Int         @default(0)
  reserved     Int         @default(0)
  available    Int         @default(0)
  reorderPoint Int         @default(10)
  status       StockStatus @default(IN_STOCK)
  
  lastRestockedAt DateTime?
  lastSoldAt      DateTime?
  updatedBy       String?
  updatedAt       DateTime  @updatedAt
  
  productVariant ProductVariant   @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  events         InventoryEvent[]
  
  @@index([productVariantId])
  @@index([status])
  @@map("inventory_records")
}

model InventoryEvent {
  id                String             @id @default(uuid())
  inventoryRecordId String
  type              InventoryEventType
  quantity          Int
  reason            String?
  performedBy       String
  createdAt         DateTime           @default(now())
  
  inventoryRecord InventoryRecord @relation(fields: [inventoryRecordId], references: [id], onDelete: Cascade)
  
  @@index([inventoryRecordId])
  @@index([createdAt])
  @@map("inventory_events")
}

model Order {
  id          String @id @default(uuid())
  storeId     String
  orderNumber String @unique
  
  customerName  String
  customerPhone String
  customerEmail String
  
  shippingAddress String
  billingAddress  String
  
  subtotal    Decimal
  deliveryFee Decimal @default(0)
  discount    Decimal @default(0)
  tax         Decimal @default(0)
  total       Decimal
  
  customerNote String?
  internalNote String?
  
  placedAt  DateTime @default(now())
  createdBy String
  updatedAt DateTime @updatedAt
  
  store       Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  lineItems   OrderLineItem[]
  payment     OrderPayment?
  fulfillment OrderFulfillment?
  events      OrderEvent[]
  messages    OrderMessage[]
  
  @@index([storeId, placedAt])
  @@index([storeId, orderNumber])
  @@index([customerEmail])
  @@map("orders")
}

model OrderLineItem {
  id               String @id @default(uuid())
  orderId          String
  productVariantId String
  
  productName String
  sku         String
  
  quantity  Int
  unitPrice Decimal
  total     Decimal
  
  createdAt DateTime @default(now())
  
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  
  @@index([orderId])
  @@index([productVariantId])
  @@map("order_line_items")
}

model OrderPayment {
  id      String @id @default(uuid())
  orderId String @unique
  
  status          PaymentStatus @default(PENDING)
  method          PaymentMethod
  reference       String?
  amount          Decimal
  paymentProofUrl String?
  
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  @@index([orderId])
  @@index([status])
  @@map("order_payments")
}

model OrderFulfillment {
  id      String @id @default(uuid())
  orderId String @unique
  
  status         FulfillmentStatus @default(UNFULFILLED)
  deliveryMethod String
  deliveryZoneId String?
  
  courierName    String?
  driverName     String?
  trackingNumber String?
  
  packedBy    String?
  deliveredBy String?
  
  assignedAt  DateTime?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryZone DeliveryZone? @relation(fields: [deliveryZoneId], references: [id])
  
  @@index([orderId])
  @@index([status])
  @@map("order_fulfillments")
}

model OrderEvent {
  id      String         @id @default(uuid())
  orderId String
  type    OrderEventType
  
  title       String
  description String?
  performedBy String?
  createdAt   DateTime @default(now())
  
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  @@index([orderId, createdAt])
  @@map("order_events")
}

model OrderMessage {
  id      String        @id @default(uuid())
  orderId String
  sender  MessageSender
  
  senderName String
  message    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  @@index([orderId, createdAt])
  @@map("order_messages")
}

model DailyMetricsSnapshot {
  id           String   @id @default(uuid())
  storeId      String
  snapshotDate DateTime @db.Date
  
  totalSales   Int
  totalRevenue Decimal
  totalCost    Decimal
  totalProfit  Decimal
  
  totalOrders     Int
  pendingOrders   Int
  completedOrders Int
  cancelledOrders Int
  
  activeProducts  Int
  lowStockCount   Int
  outOfStockCount Int
  
  totalCustomers  Int
  newCustomers    Int
  activeCustomers Int
  
  totalStockValue    Decimal
  totalStockQuantity Int
  
  createdAt DateTime @default(now())
  
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  
  @@unique([storeId, snapshotDate])
  @@index([storeId, snapshotDate])
  @@map("daily_metrics_snapshots")
}

model ProductPerformanceSnapshot {
  id               String   @id @default(uuid())
  storeId          String
  productVariantId String
  snapshotDate     DateTime @db.Date
  
  unitsSold    Int
  revenue      Decimal
  trendPercent Decimal?
  
  createdAt DateTime @default(now())
  
  store          Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  
  @@unique([storeId, productVariantId, snapshotDate])
  @@index([storeId, snapshotDate])
  @@map("product_performance_snapshots")
}
