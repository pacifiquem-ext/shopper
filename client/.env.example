# Shopper — client environment (copy to client/.env.local)
# The Next app talks to Nest only — it has no database URL.
# ./setup.sh copies this file when client/.env.local is missing.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Browser API root.
# Local (recommended): same-origin proxy via Next rewrite → Nest
NEXT_PUBLIC_API_URL=/backend/v1
# Production example:
# NEXT_PUBLIC_API_URL=https://api.example.com/v1

# Server Components / Route Handlers (absolute Nest URL)
NEXT_INTERNAL_API_URL=http://127.0.0.1:3001/v1

# Next rewrite target for /backend/* (local only)
API_PROXY_TARGET=http://127.0.0.1:3001

# SKIP_ENV_VALIDATION=true
