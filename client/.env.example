# OnlineShop.rw — client environment (copy to client/.env.local)
# Full ledger: ../ENV.md

# Public site origin (marketplace absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Nest API root including /v1 (browser)
NEXT_PUBLIC_API_URL=http://localhost:3001/v1

# Server Components catalog fetches (optional; recommended for local)
NEXT_INTERNAL_API_URL=http://127.0.0.1:3001/v1

# Bundle analyzer: ANALYZE=true pnpm build
# ANALYZE=

# Skip t3 env validation (CI/build edge cases only)
# SKIP_ENV_VALIDATION=
